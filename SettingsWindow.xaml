<Window x:Class="WINHOME.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="380"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Border CornerRadius="18"
            Background="#EE232630"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.45"
                              Color="#AA000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="设置"
                           Foreground="White"
                           FontSize="21"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderThickness="0"
                        Background="Transparent"
                        Cursor="Hand"
                        Click="ApplyButton_Click"
                        FocusVisualStyle="{x:Null}">
                    <TextBlock Text="&#xE8FB;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="#E8FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>

                <Button Grid.Column="2"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderThickness="0"
                        Background="Transparent"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        FocusVisualStyle="{x:Null}">
                    <TextBlock Text="&#xE10A;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="#E8FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="排序方式"
                           Foreground="#D8FFFFFF"
                           FontSize="13"
                           Margin="0,0,0,10"/>

                <RadioButton x:Name="AddedTimeRadio"
                             Content="添加时间"
                             GroupName="SortMode"
                             Foreground="White"
                             FontSize="15"
                             Margin="0,0,0,9"
                             Checked="AddedTimeRadio_Checked"/>

                <RadioButton x:Name="AlphabeticalRadio"
                             Content="首字母排"
                             GroupName="SortMode"
                             Foreground="White"
                             FontSize="15"
                             Checked="AlphabeticalRadio_Checked"/>
            </StackPanel>

            <StackPanel Grid.Row="3">
                <TextBlock Text="显示"
                           Foreground="#D8FFFFFF"
                           FontSize="13"
                           Margin="0,0,0,10"/>

                <CheckBox x:Name="ShowHiddenAppsCheckBox"
                          Content="显示隐藏应用"
                          Foreground="White"
                          FontSize="15"
                          Margin="0,0,0,14"
                          Checked="ShowHiddenAppsCheckBox_Changed"
                          Unchecked="ShowHiddenAppsCheckBox_Changed"/>

                <TextBlock Text="开始菜单后缀"
                           Foreground="#D8FFFFFF"
                           FontSize="13"
                           Margin="0,0,0,10"/>

                <UniformGrid Columns="2">
                    <CheckBox x:Name="ExeExtensionCheckBox"
                              Content=".exe"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,8"
                              Checked="StartMenuExtensionCheckBox_Changed"
                              Unchecked="StartMenuExtensionCheckBox_Changed"/>
                    <CheckBox x:Name="LnkExtensionCheckBox"
                              Content=".lnk"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,8"
                              Checked="StartMenuExtensionCheckBox_Changed"
                              Unchecked="StartMenuExtensionCheckBox_Changed"/>
                    <CheckBox x:Name="AppRefExtensionCheckBox"
                              Content=".appref-ms"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,8"
                              Checked="StartMenuExtensionCheckBox_Changed"
                              Unchecked="StartMenuExtensionCheckBox_Changed"/>
                    <CheckBox x:Name="WebShortcutExtensionCheckBox"
                              Content=".url/.website"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,8"
                              Checked="StartMenuExtensionCheckBox_Changed"
                              Unchecked="StartMenuExtensionCheckBox_Changed"/>
                    <CheckBox x:Name="HtmlExtensionCheckBox"
                              Content=".html/.htm/.htl"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,8"
                              Checked="StartMenuExtensionCheckBox_Changed"
                              Unchecked="StartMenuExtensionCheckBox_Changed"/>
                    <CheckBox x:Name="PdfExtensionCheckBox"
                              Content=".pdf"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,8"
                              Checked="StartMenuExtensionCheckBox_Changed"
                              Unchecked="StartMenuExtensionCheckBox_Changed"/>
                    <CheckBox x:Name="TextExtensionCheckBox"
                              Content=".txt/.rtf"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,8"
                              Checked="StartMenuExtensionCheckBox_Changed"
                              Unchecked="StartMenuExtensionCheckBox_Changed"/>
                    <CheckBox x:Name="OfficeExtensionCheckBox"
                              Content="Office 文档"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,8"
                              Checked="StartMenuExtensionCheckBox_Changed"
                              Unchecked="StartMenuExtensionCheckBox_Changed"/>
                    <CheckBox x:Name="HelpExtensionCheckBox"
                              Content=".chm/.hlp"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,8"
                              Checked="StartMenuExtensionCheckBox_Changed"
                              Unchecked="StartMenuExtensionCheckBox_Changed"/>
                    <CheckBox x:Name="OtherExtensionCheckBox"
                              Content="其他后缀"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,8"
                              Checked="StartMenuExtensionCheckBox_Changed"
                              Unchecked="StartMenuExtensionCheckBox_Changed"/>
                </UniformGrid>
            </StackPanel>

            <StackPanel Grid.Row="5">
                <TextBlock Text="应用数据"
                           Foreground="#D8FFFFFF"
                           FontSize="13"
                           Margin="0,0,0,10"/>

                <Button Height="34"
                        Margin="0,0,0,8"
                        Background="#2FFFFFFF"
                        BorderBrush="#38FFFFFF"
                        BorderThickness="1"
                        Foreground="White"
                        Content="刷新应用列表"
                        Cursor="Hand"
                        Click="RefreshListButton_Click"/>

                <Button Height="34"
                        Background="#2FFFFFFF"
                        BorderBrush="#38FFFFFF"
                        BorderThickness="1"
                        Foreground="White"
                        Content="刷新应用图标"
                        Cursor="Hand"
                        Click="RefreshIconsButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Grid.Row="7"
                       Foreground="#CFFFFFFF"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
